{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bounceless",
  "colors": {
    "primary": "#0F766E",
    "light": "#14B8A6",
    "dark": "#5EEAD4"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Verify",
        "pages": [
          "verify-single",
          "verify-batch",
          "errors"
        ]
      },
      {
        "group": "Tools",
        "pages": [
          "mcp",
          "cli",
          "agent-guide"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/verify-single",
          "api-reference/create-batch",
          "api-reference/get-batch",
          "api-reference/get-results"
        ]
      },
      {
        "group": "Changes",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl"
      ],
      "defaults": "required",
      "prefill": false
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Bounceless-io"
    }
  }
}
