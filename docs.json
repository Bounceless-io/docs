{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bounceless",
  "description": "Integrate Bounceless email verification through the GA API, CLI, MCP server, or agent skill.",
  "colors": {
    "primary": "#C43C00",
    "light": "#FF4D00",
    "dark": "#C43C00"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.bounceless.io/"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "decoration": "grid"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "quickstart",
          "authentication",
          "integration-options"
        ]
      },
      {
        "group": "Verify",
        "pages": [
          "verify-single",
          "verify-batch",
          "decisions-and-reason-codes",
          "errors"
        ]
      },
      {
        "group": "Tools",
        "pages": [
          "guides/mcp",
          "cli",
          "agent-guide"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/verify-single",
          "api-reference/create-batch",
          "api-reference/get-batch",
          "api-reference/get-results"
        ]
      },
      {
        "group": "Changes",
        "pages": [
          "migration",
          "changelog",
          "contributing"
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.yaml",
    "playground": {
      "display": "interactive",
      "credentials": false
    },
    "examples": {
      "languages": [
        "curl"
      ],
      "defaults": "required",
      "prefill": false
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.bounceless.io/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.bounceless.io/"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search API keys, batch results, decisions, errors, CLI, and MCP"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Bounceless-io"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Pricing", "href": "https://www.bounceless.io/pricing" },
          { "label": "Sign up", "href": "https://app.bounceless.io/signup" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "Terms", "href": "https://www.bounceless.io/legal/terms" },
          { "label": "Privacy", "href": "https://www.bounceless.io/legal/privacy" }
        ]
      }
    ]
  }
}
